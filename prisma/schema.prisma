// Sun Metals Store — data model.
// Money is always stored in paise (integer minor units) to avoid floating point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
}

enum LeadType {
  B2B_QUOTE
  ENGRAVING
  CONTACT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum GalleryCategory {
  ENGRAVING
  B2B_PROJECT
  STORE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CouponType {
  PERCENT
  FLAT
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  PURCHASE
  SEARCH
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions  Session[]
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  carts     Cart[]
  auditLogs AuditLog[]
  wishlist  WishlistItem[]
  resetTokens PasswordResetToken[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of the opaque cookie token; raw token is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  sku                String   @unique
  brand              String?
  material           String?
  shortDescription   String?
  description        String   @default("")
  categoryId         String
  category           Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price              Int // selling price in paise, GST inclusive
  mrp                Int // maximum retail price in paise
  costPrice          Int? // for margin analytics; never sent to the storefront
  gstRate            Int      @default(18) // percent
  hsnCode            String?
  stock              Int      @default(0)
  lowStockThreshold  Int      @default(5)
  weightGrams        Int?
  specs              Json     @default("[]") // [{ label, value }]
  tags               String[] @default([])
  isActive           Boolean  @default(true)
  isFeatured         Boolean  @default(false)
  emiEligible        Boolean  @default(true)
  engravingAvailable Boolean  @default(false)
  warranty           String?
  ratingAvg          Float    @default(0)
  ratingCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  images     ProductImage[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlistedBy WishlistItem[]

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String?
  verifiedPurchase Boolean  @default(false)
  isApproved       Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([productId, userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id            String  @id @default(cuid())
  cartId        String
  cart          Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  engravingText String  @default("")

  @@unique([cartId, productId, engravingText])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Int // percent (PERCENT) or paise (FLAT)
  minOrderAmount Int        @default(0)
  maxDiscount    Int? // cap in paise for PERCENT coupons
  usageLimit     Int?
  usedCount      Int        @default(0)
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  orders         Order[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  phone           String
  status          OrderStatus @default(PENDING_PAYMENT)
  shippingAddress Json // snapshot: { name, phone, line1, line2, city, state, pincode }
  subtotal        Int
  discount        Int         @default(0)
  shippingFee     Int         @default(0)
  taxTotal        Int // GST component already included in subtotal (for invoices)
  total           Int
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  preferEmi       Boolean     @default(false)
  notes           String?

  invoiceNumber     String? @unique // GST: consecutive per financial year, e.g. SM/26-27/000042
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  paymentMethod     String? // card | upi | netbanking | wallet | emi | cardless_emi | paylater
  paymentDetails    Json? // bank, card network, emi tenure, cardless provider, etc.
  paidAt            DateTime?
  stockCommitted    Boolean   @default(false)
  trackingNumber    String?
  courier           String?

  items     OrderItem[]
  events    OrderEvent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  sku           String
  image         String?
  unitPrice     Int
  quantity      Int
  gstRate       Int
  engravingText String   @default("")

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Every Razorpay webhook is stored once, keyed by its event id, so redeliveries are idempotent.
model WebhookEvent {
  id         String   @id // x-razorpay-event-id
  type       String
  payload    Json
  receivedAt DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  type      LeadType
  status    LeadStatus @default(NEW)
  name      String
  company   String?
  email     String?
  phone     String
  city      String?
  message   String?
  details   Json       @default("{}")
  adminNote String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([type, status])
  @@index([createdAt])
}

model GalleryItem {
  id          String          @id @default(cuid())
  title       String
  description String?
  category    GalleryCategory
  mediaType   MediaType       @default(IMAGE)
  url         String
  isPublished Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaLabel  String?
  ctaHref   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}

// First-party analytics: anonymous visitor id cookie, no IP addresses stored.
model AnalyticsEvent {
  id        String    @id @default(cuid())
  type      EventType
  visitorId String
  userId    String?
  path      String?
  productId String?
  value     Int? // paise, for PURCHASE / ADD_TO_CART
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([type, createdAt])
  @@index([productId, type])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Atomic per-financial-year counter for GST invoice serial numbers.
model InvoiceCounter {
  fy   String @id // e.g. "26-27"
  last Int    @default(0)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
}
